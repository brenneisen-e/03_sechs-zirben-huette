{
  "name": "sechszirbenhuette",
  "version": "1.0.0",
  "description": "Premium-Hüttenurlaub in den Kärntner Nockbergen",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pages:build": "node scripts/pages-build.mjs",
    "preview": "opennextjs-cloudflare build && wrangler dev",
    "deploy": "opennextjs-cloudflare build && wrangler pages deploy .open-next/assets --project-name=sechszirbenhuette",
    "db:migrate": "wrangler d1 execute sechszirbenhuette-db --file=./db/schema.sql",
    "db:seed": "wrangler d1 execute sechszirbenhuette-db --file=./db/seed.sql",
    "set-admin-password": "node scripts/set-admin-password.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/brenneisen-e/sechszirbenhuette"
  },
  "keywords": [
    "ferienhaus",
    "kärnten",
    "nockberge",
    "hüttenurlaub",
    "falkert"
  ],
  "author": "Malte + Mareike Brenneisen",
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@tiptap/extension-bubble-menu": "^3.20.4",
    "@tiptap/extension-image": "^3.20.4",
    "@tiptap/extension-link": "^3.20.4",
    "@tiptap/extension-placeholder": "^3.20.4",
    "@tiptap/extension-text-align": "^3.20.4",
    "@tiptap/extension-underline": "^3.20.4",
    "@tiptap/pm": "^3.20.4",
    "@tiptap/react": "^3.20.4",
    "@tiptap/starter-kit": "^3.20.4",
    "autoprefixer": "^10.4.23",
    "clsx": "^2.1.1",
    "framer-motion": "^12.26.2",
    "hls.js": "^1.5.0",
    "lucide-react": "^0.562.0",
    "next": "^16.4.3",
    "postcss": "^8.5.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260116.0",
    "@eslint/js": "^9.39.4",
    "@opennextjs/cloudflare": "^1.20.14",
    "@types/node": "^25.0.8",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "lefthook": "^2.1.4",
    "prettier": "3.8.1",
    "typescript-eslint": "^8.58.0",
    "wrangler": "^4.156.0"
  },
  "optionalDependencies": {
    "@next/swc-linux-x64-gnu": "16.4.3",
    "@next/swc-linux-x64-musl": "16.4.3"
  },
  "overrides": {
    "glob@<13": "13.0.6",
    "formdata-node": "6.0.3"
  }
}
